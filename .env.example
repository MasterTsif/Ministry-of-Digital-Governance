# Copy this file to .env for a new installation.

# Discord
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# Class timetable monitoring
SCHEDULE_ENABLED=false
SCHEDULE_API_URL=https://www.iee.ihu.gr/wp-json/wp/v2/pages/101
ALERT_CHANNEL_ID=
ALERT_ROLE_ID=
ALERT_USER_ID=
CHECK_TIMEZONE=Europe/Athens
ACTIVE_WEEKDAYS=0,1,2,3,4
MORNING_START=08:00
EVENING_START=14:00
NIGHT_START=18:00
DAY_INTERVAL_MINUTES=5
EVENING_INTERVAL_MINUTES=15

# Exam monitoring; omitted exam alert IDs inherit the class timetable IDs.
EXAMS_ENABLED=false
EXAMS_PAGE_URL=https://www.iee.ihu.gr/exams-program/
# EXAMS_ALERT_CHANNEL_ID=
# EXAMS_ALERT_ROLE_ID=
# EXAMS_ALERT_USER_ID=
EXAMS_CHECK_TIMEZONE=Europe/Athens
EXAMS_ACTIVE_WEEKDAYS=0,1,2,3,4
EXAMS_MORNING_START=08:00
EXAMS_EVENING_START=14:00
EXAMS_NIGHT_START=18:00
EXAMS_DAY_INTERVAL_MINUTES=5
EXAMS_EVENING_INTERVAL_MINUTES=15

# Button-based notification subscriptions
NOTIFICATIONS_ENABLED=false

# GIF blocker
GIF_BLOCK_ENABLED=false
GIF_EXEMPT_IDS=
GIF_EXEMPT_CHANNEL_IDS=
GIF_LOG_CHANNEL_ID=

# Runtime
DATABASE_PATH=data/production.sqlite3
REQUEST_TIMEOUT_SECONDS=20
